{
  "name": "jassmin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "aspire": "node scripts/aspire.mjs",
    "aspire:build": "pnpm --dir aspire-apphost run build",
    "herdr:plans": "node scripts/herdr-plans.mjs",
    "worktree:remove": "node scripts/remove-worktree.mjs",
    "cms:dev": "pnpm --filter jassmin-cms develop",
    "cms:build": "pnpm --filter jassmin-cms build",
    "cms:seed": "pnpm --filter jassmin-cms seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:rollback": "tsx app/.server/db/scripts/rollback.ts",
    "db:seed": "tsx app/.server/db/scripts/seed.ts",
    "db:make-admin": "tsx app/.server/db/scripts/make-admin.ts",
    "db:mark-abandoned-carts": "tsx app/.server/db/scripts/mark-abandoned-carts.ts",
    "db:send-order-emails": "tsx app/.server/db/scripts/send-order-emails.ts",
    "db:sync-cms": "tsx app/.server/db/scripts/sync-cms.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "drizzle-orm": "^0.45.4",
    "isbot": "^5.1.36",
    "marked": "^18.1.1",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.15.0"
}
