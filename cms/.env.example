# Strapi server. Under `pnpm aspire run`, PORT is set by Aspire.
HOST=0.0.0.0
PORT=1337

# Secrets: generate each with
#   node -e "console.log(require('node:crypto').randomBytes(16).toString('base64'))"
# APP_KEYS is a comma-separated list of at least two such values.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database. Under `pnpm aspire run`, DATABASE_URL is injected for the `strapidb` database and
# takes precedence. Without Aspire, set DATABASE_URL or the discrete variables below.
DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strapidb
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapidb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Product and order management (#40): saving a product or an order in the admin first sends the
# change to the Jassmin app, which keeps the real stock and orders. JASSMIN_APP_URL is the app's
# URL (under `pnpm aspire run`, Aspire sets it); CMS_SYNC_SECRET must equal the app's (root .env),
# at least 32 characters. Without them, saving a product or an order fails with a clear message.
JASSMIN_APP_URL=http://localhost:5173
CMS_SYNC_SECRET=change-me-to-the-same-long-random-string-as-in-the-app
