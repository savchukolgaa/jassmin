{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home page",
    "description": "Hero, about us and location sections of the home page"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "aboutImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "hero": {
      "type": "component",
      "repeatable": false,
      "component": "home.hero",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "about": {
      "type": "component",
      "repeatable": false,
      "component": "home.about",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "location": {
      "type": "component",
      "repeatable": false,
      "component": "home.location",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
