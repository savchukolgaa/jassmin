{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": "Orders placed in the shop (#40). Only Order status, Payment status and Cancel reason can be changed here; the shop checks every change, sets the dates and restores stock on cancellation. Cancelling needs a cancel reason (#128). (`orderStatus`, because Strapi reserves `status`.)"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "orderId": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": ["pending", "paid", "shipped", "completed", "cancelled", "returned", "unclaimed"],
      "required": true,
      "default": "pending"
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": ["unpaid", "paid", "refunded"],
      "required": true,
      "default": "unpaid"
    },
    "paymentMethod": {
      "type": "enumeration",
      "enum": ["card", "cod", "gift_card"],
      "required": true
    },
    "customerName": {
      "type": "string"
    },
    "customerEmail": {
      "type": "email"
    },
    "customerPhone": {
      "type": "string"
    },
    "userId": {
      "type": "integer"
    },
    "shippingAddress": {
      "type": "text"
    },
    "freeShipping": {
      "type": "boolean",
      "default": false
    },
    "subtotal": {
      "type": "decimal"
    },
    "discountAmount": {
      "type": "decimal"
    },
    "shippingAmount": {
      "type": "decimal"
    },
    "giftCardAmount": {
      "type": "decimal"
    },
    "totalAmount": {
      "type": "decimal"
    },
    "currency": {
      "type": "string",
      "default": "UAH"
    },
    "placedAt": {
      "type": "datetime"
    },
    "paidAt": {
      "type": "datetime"
    },
    "shippedAt": {
      "type": "datetime"
    },
    "completedAt": {
      "type": "datetime"
    },
    "cancelledAt": {
      "type": "datetime"
    },
    "refundedAt": {
      "type": "datetime"
    },
    "returnedAt": {
      "type": "datetime"
    },
    "cancelReason": {
      "type": "enumeration",
      "enum": ["customer_request", "out_of_stock", "no_answer", "payment_failed", "other"]
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "orders.item"
    }
  }
}
