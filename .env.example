# PostgreSQL connection string for runs without Aspire. Under `aspire run` it's ignored: the
# injected JASSMINDB_URI takes precedence.
DATABASE_URL=postgres://jassmin:jassmin@localhost:5432/jassmin

# Secret used to sign the session cookie (at least 32 characters).
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Port for the production server (`pnpm start`).
PORT=3000

# The site's public origin, used for canonical and Open Graph URLs (#85). Required when
# NODE_ENV=production; in development the request's origin is used when it's unset.
# PUBLIC_SITE_URL=https://jassmin.ua

# Strapi CMS base URL (default http://localhost:1337). Under `aspire run`, Aspire sets it.
# STRAPI_URL=http://localhost:1337

# Read-only Strapi API token (see README → "Content (Strapi CMS)"). Without it, CMS-backed
# pages answer with a 503.
STRAPI_API_TOKEN=

# Products and orders are managed in Strapi (#40). STRAPI_SYNC_TOKEN is the Strapi API token
# that may write products and orders (`pnpm cms:seed -- --token` prints it); without it, order
# and stock changes stay queued for Strapi. CMS_SYNC_SECRET (32+ characters, the same value as in
# cms/.env) is what Strapi sends to the app's /cms/* routes; without it, saving a product or an
# order in the Strapi admin fails.
STRAPI_SYNC_TOKEN=
# CMS_SYNC_SECRET=change-me-to-the-same-long-random-string-as-in-cms-env

# Card payments (#44). `simulator` serves a local fake payment page (development only; refused
# when NODE_ENV=production). Without it, card payment is unavailable at checkout.
# PAYMENT_PROVIDER=simulator

# /robots.txt disallows everything outside production; set this on a staging server that runs
# with NODE_ENV=production so it is not indexed either (#87).
# ROBOTS_DISALLOW_ALL=true

# Content-Security-Policy mode (#143, see docs/security.md): `report-only` (default) only logs
# violations, `enforce` blocks them. Switch to `enforce` after a week of clean `[csp]` logs.
# CSP_MODE=report-only

# Reverse proxies in front of the app that append to X-Forwarded-For (#143). The per-IP rate
# limits trust only the entries they add. 0 (default) ignores the header, so set it to 1 behind
# a single hosting proxy or load balancer.
# TRUSTED_PROXY_HOPS=0

# SMTP server for contact form and order emails. Locally that's smtp4dev: under `aspire run`
# Aspire sets it, otherwise run `docker run --rm -p 5000:80 -p 2525:25 rnwood/smtp4dev` (web UI
# on :5000). Without it, development logs contact messages instead of sending them, and order
# confirmations stay queued until it is set.
# SMTP_URL=smtp://localhost:2525

# Where contact form emails go, and the sender they come from.
# CONTACT_INBOX=hello@jassmin.ua
# CONTACT_FROM=Jassmin website <no-reply@jassmin.ua>

# Sender of order confirmation emails (default: CONTACT_FROM). Replies go to CONTACT_INBOX.
# ORDER_FROM=Jassmin <orders@jassmin.ua>

# Hours without activity after which `pnpm db:mark-abandoned-carts` marks a cart abandoned.
# ABANDONED_CART_HOURS=24
