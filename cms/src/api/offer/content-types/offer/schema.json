{
  "kind": "collectionType",
  "collectionName": "offers",
  "info": {
    "singularName": "offer",
    "pluralName": "offers",
    "displayName": "Offer",
    "description": "Special offers, discovery sets, gift ideas and perks shown on /offers"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 120,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "kind": {
      "type": "enumeration",
      "enum": ["discovery-set", "seasonal", "gift", "bundle", "featured", "last-units", "perk"],
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "summary": {
      "type": "text",
      "maxLength": 300,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "body": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "startsAt": {
      "type": "datetime",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "endsAt": {
      "type": "datetime",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "priceNote": {
      "type": "string",
      "maxLength": 80,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "products": {
      "type": "component",
      "repeatable": true,
      "component": "offers.product-ref",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "ctaLabel": {
      "type": "string",
      "maxLength": 40,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "ctaUrl": {
      "type": "string",
      "maxLength": 300,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
