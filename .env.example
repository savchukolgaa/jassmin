# PostgreSQL connection string for runs without Aspire. Under `aspire run` it's ignored: the
# injected JASSMINDB_URI takes precedence.
DATABASE_URL=postgres://jassmin:jassmin@localhost:5432/jassmin

# Secret used to sign the session cookie (at least 32 characters).
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Port for the production server (`pnpm start`).
PORT=3000

# Strapi CMS base URL (default http://localhost:1337). Under `aspire run`, Aspire sets it.
# STRAPI_URL=http://localhost:1337

# Read-only Strapi API token (see README → "Content (Strapi CMS)"). Without it, CMS-backed
# pages answer with a 503.
STRAPI_API_TOKEN=

# SMTP server for contact form and order emails. Locally that's smtp4dev: under `aspire run`
# Aspire sets it, otherwise run `docker run --rm -p 5000:80 -p 2525:25 rnwood/smtp4dev` (web UI
# on :5000). Without it, development logs contact messages instead of sending them, and order
# confirmations stay queued until it is set.
# SMTP_URL=smtp://localhost:2525

# Where contact form emails go, and the sender they come from.
# CONTACT_INBOX=hello@jassmin.ua
# CONTACT_FROM=Jassmin website <no-reply@jassmin.ua>

# Sender of order confirmation emails (default: CONTACT_FROM). Replies go to CONTACT_INBOX.
# ORDER_FROM=Jassmin <orders@jassmin.ua>

# Hours without activity after which `pnpm db:mark-abandoned-carts` marks a cart abandoned.
# ABANDONED_CART_HOURS=24
