{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "The perfume catalogue (#40). Saving writes through to the shop's database, which keeps the real stock; untick Active (or delete) to archive a product."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "brand": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "description": {
      "type": "text"
    },
    "gender": {
      "type": "enumeration",
      "enum": ["women", "men", "unisex"],
      "required": true
    },
    "fragranceFamilies": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.fragrance-family"
    },
    "notes": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.note"
    },
    "storeCode": {
      "type": "string",
      "maxLength": 20
    },
    "popularRank": {
      "type": "integer",
      "min": 1
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "packSize": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "variants": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.variant",
      "required": true,
      "min": 1
    },
    "publicId": {
      "type": "string",
      "unique": true,
      "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
