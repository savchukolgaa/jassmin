{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site settings",
    "description": "Store contact details, social links and the data controller's legal name"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "phone": { "type": "string", "required": true, "maxLength": 50 },
    "email": { "type": "email", "required": true },
    "customerServiceHours": { "type": "string", "maxLength": 200 },
    "legalName": { "type": "string", "maxLength": 255 },
    "socialLinks": { "type": "component", "repeatable": true, "component": "shared.social-link" }
  }
}
